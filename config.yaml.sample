# Пример конфигурации subsong.
# Скопируйте в subsong.yaml и правьте под себя: subsong song.mp4 --config subsong.yaml
# Значения из командной строки всегда имеют приоритет над этим файлом.

# Стиль субтитров
style:
  max_chars: 42          # максимум символов в строке
  max_lines: 2           # максимум строк в одной реплике
  min_duration: 1.0      # реплика не должна мелькать быстрее, с
  max_duration: 7.0      # максимум секунд на реплику
  max_cps: 20.0          # максимум символов в секунду (скорость чтения)
  min_gap: 0.08          # минимальная пауза между репликами, с
  lead_in: 0.0           # показывать реплику на N секунд раньше звучания
  lead_out: 0.2          # держать реплику на N секунд дольше
  uppercase: false       # ВЕРХНИЙ РЕГИСТР

# Детектор речи (Silero VAD). На музыке пригодится поднять threshold,
# если реплики сливаются, или опустить, если теряются начала строк.
vad:
  threshold: 0.35        # для песен лучше стандартного 0.5: минусовка маскирует начало фразы
  min_silence: 0.35      # пауза, разделяющая фразы, с
  min_speech: 0.2        # минимальная длительность речи, с
  max_speech: 20.0       # максимум секунд в одном отрезке

# Фильтры мусорных реплик (галлюцинации ASR на инструментале).
filters:
  min_confidence: -4.0   # отсечь всё, что хуже порога; -99 отключить
  max_repeat_words: 0    # отбрасывать повторы слов/блоков (0 - выключено)
  min_segment_sec: 0.0   # игнорировать слишком короткие отрезки, с
  music_gate: 0          # 0 - выключен, 1 - консервативный, 2 - агрессивный
  min_rms_db: -55.0      # тише этого считать тишиной

# Вычисления
runtime:
  num_threads: 2         # потоки ONNX Runtime
  provider: "cpu"        # cpu / cuda
  normalize: "none"      # none | peak | rms (полезно для тихих записей)
  quiet: false